<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Icons\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="imagens.png" />
    <None Remove="Assets\Images\Main.png" />
    <None Remove="Assets\Images\Splash.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\Main.png" />
    <Resource Include="Assets\Images\Splash.png" />
  </ItemGroup>

</Project>
