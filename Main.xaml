<Window x:Class="TextReplacer.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextReplacer"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="TextReplacer" Height="550" Width="800">
    <Grid Background="White">
        <TextBlock HorizontalAlignment="Left" Margin="40,28,0,0" TextWrapping="Wrap" Text="TextReplacer" VerticalAlignment="Top" FontSize="24" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="40,65,0,0" Text="Localize uma palavra em um documento de texto e substitua por outra palavra" VerticalAlignment="Top" FontSize="16" TextWrapping="Wrap" Width="310"/>
        <Image HorizontalAlignment="Right" Height="102" Margin="0,28,41,0" VerticalAlignment="Top" Width="146" Source="/images/Main.png" OpacityMask="Black" Grid.Row="0"/>
        <StackPanel Margin="40,122,41,51">
            <GroupBox Height="100" Header="1. Selecionar arquivo" Background="White" FontSize="20" FontWeight="Bold" BorderThickness="2,2,2,2">
                <Border Height="56" Margin="16,0,16,0" BorderBrush="#FFD5DFE5" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" >
                    <Grid>
                        <Label x:Name="lblCaminho" Content="Nenhum arquivo selecionado" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Normal" FontSize="16"/>
                        <Border HorizontalAlignment="Left" Margin="490,0,0,0" VerticalAlignment="Center" CornerRadius="10,10,10,10" Background="#FFDDDDDD" >
                            <Button x:Name="btnArquivo" Content="Escolher arquivo" Cursor="Hand" Click="btnArquivo_Click" FontWeight="Normal" Height="31" Width="149" BorderThickness="0,0,0,0" Margin="3,3,3,3"/>
                        </Border>
                    </Grid>
                </Border>
            </GroupBox>
            <GroupBox Height="100" Header="2. Termos" Background="White" FontWeight="Bold" FontSize="20" BorderThickness="2,2,2,2">
                <Grid>
                    <Border HorizontalAlignment="Left" Margin="16,22,0,0" VerticalAlignment="Top" Width="296" CornerRadius="10,10,10,10" BorderThickness="2,2,2,2" BorderBrush="#FFD5DFE5">
                        <TextBox x:Name="TxtSubstituir" TextWrapping="Wrap" Height="29" Margin="2,2,2,2" BorderThickness="0,0,0,0" FontWeight="Normal" FontSize="16"/>
                    </Border>
                    <Border HorizontalAlignment="Left" Margin="378,22,0,0" VerticalAlignment="Top" Width="303" CornerRadius="10,10,10,10" BorderThickness="2,2,2,2" BorderBrush="#FFD5DFE5">
                        <TextBox x:Name="TxtSubstituto" TextWrapping="Wrap" Height="29" BorderThickness="0,0,0,0" Margin="2,2,2,2" FontWeight="Normal" FontSize="16"/>
                    </Border>
                    <Label Content="-&gt;" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"/>
                    <TextBlock HorizontalAlignment="Left" Margin="17,0,0,0" TextWrapping="Wrap" Text="Termo a ser substituido" VerticalAlignment="Top" FontSize="16" FontWeight="Normal"/>
                    <TextBlock HorizontalAlignment="Left" Margin="380,1,0,0" TextWrapping="Wrap" Text="Substituir por" VerticalAlignment="Top" FontSize="16" FontWeight="Normal"/>
                </Grid>
            </GroupBox>
            <GroupBox Height="100" Header="3. Ações" Background="White" FontSize="20" FontWeight="Bold" BorderThickness="2,2,2,2">
                <Grid>
                    <Border Height="45" Margin="14,11,442,10" Background="#FF2478CE" CornerRadius="10,10,10,10" >
                        <Button x:Name="btnSubstituir" Content="Substituir no arquivo" Cursor="Hand" Background="#FF2478CE" Foreground="White" FontWeight="Normal" BorderThickness="0,0,0,0" Margin="3,3,3,3" Click="btnSubstituir_Click"/>
                    </Border>
                </Grid>
            </GroupBox>
        </StackPanel>
    </Grid>
</Window>
